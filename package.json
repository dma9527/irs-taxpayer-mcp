{
  "name": "irs-taxpayer-mcp",
  "version": "1.2.7",
  "mcpName": "io.github.dma9527/irs-taxpayer",
  "description": "Deterministic local US individual tax engine with direct no-model CLI and MCP adapters for supported TY2024 through TY2026 scenarios",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "dist/index.js",
  "bin": {
    "irs-taxpayer-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "ROADMAP.md",
    "CHANGELOG.md",
    "docs/PLANNER_CONTRACT.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dma9527/irs-taxpayer-mcp.git"
  },
  "homepage": "https://github.com/dma9527/irs-taxpayer-mcp",
  "author": "Ding Ma",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.test.json",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "mcp",
    "irs",
    "tax",
    "taxpayer",
    "model-context-protocol",
    "federal-tax",
    "state-tax",
    "tax-calculator",
    "tax-credits",
    "retirement"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/express": "5.0.6",
    "@types/node": "22.20.1",
    "@vitest/coverage-v8": "4.1.12",
    "eslint": "10.15.0",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0",
    "vitest": "4.1.12"
  }
}
